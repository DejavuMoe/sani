{
  "name": "sani-docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vitepress dev --host 127.0.0.1 --port 5174",
    "build": "node .vitepress/sync/check.ts && vitepress build && node scripts/check-seo.mjs && node --test scripts/preview.test.mjs",
    "preview": "vitepress preview --host 127.0.0.1 --port 4174",
    "check": "node .vitepress/sync/check.ts && node --test .vitepress/sync/check.test.ts .vitepress/markdown.test.ts .vitepress/seo.test.ts && vue-tsc --noEmit",
    "a11y": "node scripts/a11y.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "catalog:",
    "@fontsource/ibm-plex-mono": "catalog:",
    "ecoku": "0.3.7",
    "vitepress": "1.6.4",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "axe-core": "catalog:",
    "typescript": "catalog:",
    "vue-tsc": "3.3.12"
  }
}
