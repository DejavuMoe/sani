# Copy to .env (or your service manager's environment) and adjust.

# Address to listen on.
SANI_LISTEN=:8080
# Where the SQLite database and shared files live.
SANI_DATA_DIR=./data
# The public origin of your short links. Empty: derived from each request.
SANI_BASE_URL=https://s.example.com
# Optional fixed admin password (8+ characters). Empty: set it on first visit,
# which asks for the setup code printed to the log.
SANI_PASSWORD=
# Fixed setup code for that first visit. Empty: a random one at each start.
SANI_SETUP_CODE=
# Where the bare domain "/" redirects. Empty: the admin app.
SANI_ROOT_REDIRECT=
# Honor X-Forwarded-* / X-Real-IP. Only enable behind a proxy that sets them.
# The client address is the last X-Forwarded-For entry.
SANI_TRUST_PROXY=false
# Generated URL slug length (3-32; new-install default 5).
# Empty keeps the saved setting or built-in default; explicit values lock
# only their own field in Settings. Each length is saved independently.
SANI_SLUG_LENGTH=
# Generated text/code share slug length (3-32; new-install default 10).
# Initial upgrade preserves max(10, legacy effective URL length) for shares;
# later URL-length edits do not affect them. Lengths exclude /p/.
SANI_TEXT_SLUG_LENGTH=
# Generated file share slug length (3-32; new-install default 10).
# Shares always exclude look-alikes; below 10 is allowed but easier to guess.
SANI_FILE_SLUG_LENGTH=
# URL slugs only. Empty keeps Settings editable; true excludes 0/o and 1/i/l.
SANI_EXCLUDE_CONFUSABLE=
# Fetch page titles and icons for new links.
SANI_FETCH_META=
# Optional dedicated http://, https:// or socks5:// proxy; never falls back direct.
# Credentials may be included in this server-only URL.
SANI_META_PROXY=
# Pass the visitor's query string on to the destination.
SANI_FORWARD_QUERY=true
# Redirect targets kept in memory.
SANI_CACHE_SIZE=100000
# A second domain, pointed at this same Sani, that serves shared files and raw
# text. It must differ from SANI_BASE_URL's host. Empty: no file sharing.
SANI_FILES_URL=
# Empty: 99,000,000 bytes or saved admin setting. Explicit 1-4096 values
# retain MiB semantics for compatibility; an explicit value locks the UI.
SANI_MAX_FILE_MB=
# debug | info | warn | error, and text | json
SANI_LOG_LEVEL=info
SANI_LOG_FORMAT=text
# Time zone for daily statistics.
TZ=Asia/Shanghai
